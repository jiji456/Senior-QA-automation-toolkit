{
  "name": "qa-automation-toolkit",
  "version": "1.0.0",
  "description": "Comprehensive QA Automation Toolkit for Senior QA Engineers",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:web && npm run test:api",
    "test:web": "playwright test",
    "test:web:headed": "playwright test --headed",
    "test:web:debug": "playwright test --debug",
    "test:api": "jest --config jest-api.config.js",
    "test:api:watch": "jest --config jest-api.config.js --watch",
    "test:performance": "k6 run tests/performance/",
    "test:visual": "playwright test --config playwright-visual.config.ts",
    "test:accessibility": "playwright test --config playwright-a11y.config.ts",
    "test:mobile": "playwright test --config playwright-mobile.config.ts",
    "report:generate": "allure generate allure-results --clean",
    "report:open": "allure open allure-report",
    "lint": "eslint . --ext .ts,.js",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "setup": "npm install && npx playwright install && npx playwright install-deps"
  },
  "keywords": [
    "qa",
    "automation",
    "testing",
    "playwright",
    "api-testing",
    "performance-testing"
  ],
  "author": "Senior QA Automation Engineer",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "allure-commandline": "^2.24.0",
    "allure-playwright": "^2.0.0",
    "axios": "^1.6.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.2.0"
  },
  "dependencies": {
    "dotenv": "^16.3.0",
    "winston": "^3.11.0",
    "axe-playwright": "^2.0.0"
  }
}
