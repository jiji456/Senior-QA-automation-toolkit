# QA Automation Toolkit Configuration
# คอนฟิกูเรชันสำหรับเครื่องมือ QA Automation

# Base URLs
BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api

# Test Environment (dev, staging, production)
TEST_ENV=dev

# Browser Configuration
DEFAULT_BROWSER=chromium
HEADLESS=true
SLOW_MO=0

# API Configuration
API_TIMEOUT=30000
API_RETRY_ATTEMPTS=3

# Test Data
TEST_DATA_PATH=./test-data
SCREENSHOT_PATH=./screenshots
VIDEO_PATH=./videos

# Reporting
ALLURE_RESULTS_DIR=./allure-results
ALLURE_REPORT_DIR=./allure-report

# Performance Testing
K6_VUS=10
K6_DURATION=30s

# Mobile Testing
DEVICE_PIXEL_RATIO=2
DEVICE_WIDTH=375
DEVICE_HEIGHT=667

# Visual Regression
VISUAL_THRESHOLD=0.2

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/automation.log

# Database (for test data management)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=test_db
DB_USER=test_user
DB_PASSWORD=test_password

# External Services
EMAIL_SERVICE_URL=https://api.email-service.com
SMS_SERVICE_URL=https://api.sms-service.com

# Authentication
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=test123
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=admin123

# Feature Flags
ENABLE_API_TESTS=true
ENABLE_WEB_TESTS=true
ENABLE_PERFORMANCE_TESTS=true
ENABLE_VISUAL_TESTS=true
ENABLE_ACCESSIBILITY_TESTS=true
